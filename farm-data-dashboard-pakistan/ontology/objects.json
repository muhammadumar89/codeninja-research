{
  "package": "hyper-ontology/1",
  "designed_with": "Praxis",
  "implemented_with": "Hyper Ontology",
  "paper": {
    "title": "Field Ledger: An Open Source Agriculture Data Dashboard the Operator Fully Owns",
    "url": "https://codeatoms.ai/farm-data-dashboard-pakistan/",
    "doi": "10.5281/zenodo.23186671"
  },
  "sector": "agriculture-and-earth-observation",
  "country": "Pakistan",
  "scenario": "the operator is described by class, never by name; the design answers a public requirement in this sector",
  "source": "chapter 5 of the paper (5.1 objects, 5.3 recorded form) and Figure 4 (cards and typed links as drawn); Figure 4's title counts 14 typed links and draws 12 lines, all kept here",
  "write_paths": [
    "read-only adapters over the repository, the historical datasets and the site sensor feeds",
    "alerts, reports and acknowledgements on the model; nothing writes back into a source system"
  ],
  "human_loop": "every alert is acknowledged by a named dashboard user under a role the operator assigns; the dashboard reports and never controls farm equipment",
  "objects": [
